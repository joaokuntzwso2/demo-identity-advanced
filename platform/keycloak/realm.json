      "enabled": true,
      "emailVerified": true,
      "firstName": "Fernanda",
      "lastName": "Oliveira",
      "email": "fernanda.oliveira@marketsphere.local",
      "attributes": {
        "department": [
          "Finance"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "Federated@123",
          "temporary": false
        }
      ],
      "groups": [
        "portal_users",
        "finance_users"
      ]
    },
    {
      "username": "external.contractor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Rafael",
      "lastName": "Mendes",
      "email": "rafael.mendes@partner.local",
