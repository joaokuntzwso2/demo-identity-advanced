# WSO2 Identity Server administrator
WSO2_ADMIN_USER=admin
WSO2_ADMIN_PASSWORD=admin

# Demo users
ALICE_PASSWORD=Alice@123
BOB_PASSWORD=Bob@1234
CAROL_PASSWORD=Carol@123
LDAP_PASSWORD=Corporate@123

# Keycloak demo federation
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional real Microsoft Entra ID connection.
# Leave blank to use the fully local Keycloak OIDC provider.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Bootstrap controls
BOOTSTRAP_STRICT=false
