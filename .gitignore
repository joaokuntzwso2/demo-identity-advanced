# -----------------------------------------------------------------------------
# WSO2 runtime data
# -----------------------------------------------------------------------------

# Embedded H2 databases
*.mv.db
*.trace.db
*.h2.db
*.lock.db

# WSO2 runtime database directories
platform/wso2/repository/database/
platform/wso2/database/
platform/wso2/data/

# WSO2 generated runtime directories if the product is unpacked locally
**/repository/logs/
**/repository/tmp/
**/repository/work/
**/repository/components/patches/
**/repository/components/dropins/
**/repository/deployment/server/webapps/

# Carbon and WSO2 logs
wso2carbon.log*
audit.log*
http_access*.log*
patches.log*
correlation.log*
memory.log*
gc.log*
gc-*.log*

# Do not ignore source-controlled WSO2 configuration
!platform/wso2/deployment.toml
!platform/wso2/userstores/
!platform/wso2/userstores/**
!platform/wso2/**/*.xml


